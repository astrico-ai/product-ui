{
  "buildCommand": "cd server && npm install && cd .. && npm run build",
  "installCommand": "npm install && cd server && npm install",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "github": {
    "silent": true
  },
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
} 