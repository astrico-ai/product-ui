{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "github": {
    "silent": true
  },
  "framework": "vite",
  "functions": {
    "api/index.js": {
      "runtime": "nodejs18.x"
    }
  }
} 